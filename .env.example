# chain-api Community Signer — Example Configuration

# ---- Signer identity ----
SIGNER_MODE=community
SIGNER_ID=signer_dev_1
SIGNER_NAME=Dev Signer 1
TENANT_ID=tenant_default

# ---- chain-api connection ----
CHAIN_API_BASE_URL=http://localhost:3000
SIGNER_API_KEY=your-tenant-api-key-here

# ---- Polling ----
POLL_INTERVAL_MS=5000
TASK_BATCH_SIZE=5

# ---- Supported chains ----
SUPPORTED_CHAINS=bitcoin
SUPPORTED_ASSETS=bitcoin:BTC
SUPPORTED_FORMATS=btc_psbt

# ---- BTC signing (dev: use raw WIF key from ENV) ----
# In production, use BTC_KEYSTORE_PATH + BTC_KEYSTORE_PASSWORD
BTC_SIGNING_MODE=dev_env_key
BTC_DEV_PRIVATE_KEY_WIF=cRm5Hh7...  # Testnet WIF key — NEVER use mainnet keys in .env
BTC_NETWORK=testnet

# ---- Policy guards ----
MAX_AUTO_SIGN_AMOUNT_SATS=1000000
MAX_FEE_RATE_SAT_VB=50
MAX_OUTPUTS_PER_BATCH=200
ALLOWED_DESTINATIONS=           # comma-separated, empty = allow all

# ---- Audit ----
AUDIT_LOG_FILE=./data/audit.log  # set to "" to disable file audit
AUDIT_STDOUT=true

# ---- Health / status port ----
SIGNER_PORT=3101
SIGNER_BIND_HOST=127.0.0.1

# ---- Auto-enrollment ----
SIGNER_AUTO_ENROLL=true
SIGNER_FINGERPRINT=btc:devkey:0000000000000000
SIGNER_PUBLIC_KEY=ed25519:placeholder
