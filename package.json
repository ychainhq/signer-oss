{
  "name": "chain-api-signer-oss",
  "version": "1.0.1",
  "description": "chain-api Community/OSS External Signer Daemon",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testTimeout": 10000
  },
  "dependencies": {
    "@chain-api/external-signer-protocol": "file:../packages/external-signer-protocol",
    "@chain-api/external-signer-core": "file:../packages/external-signer-core",
    "bitcoinjs-lib": "^6.1.5",
    "ecpair": "^2.1.0",
    "bip32": "^5.0.1",
    "tiny-secp256k1": "^2.2.4",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.4.3",
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "@types/jest": "^30.0.0"
  }
}
